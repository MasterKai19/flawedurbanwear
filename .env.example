DB_HOST=your-cloud-mysql-host
DB_PORT=3306
DB_NAME=defaultdb
DB_USER=your-cloud-mysql-user
DB_PASSWORD=your-cloud-mysql-password
# Paste the full CA certificate into this Vercel variable (BEGIN/END lines included).
DB_SSL_CA=your-cloud-mysql-ca-certificate
OWNER_EMAIL=your-owner-email@example.com
OWNER_PASSWORD=choose-a-private-password-at-least-12-characters
CRON_SECRET=choose-a-different-random-secret-at-least-32-characters
# Connect Google Sheets/email in Admin > Settings > Google & Email after setup.
