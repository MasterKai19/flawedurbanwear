{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {"api/index.php": {"runtime": "vercel-php@0.9.0", "maxDuration": 60}},
  "routes": [
    {"src": "/assets/(.*\\.(?:css|js|png|jpg|jpeg|webp|svg|ico|woff2))", "dest": "/assets/$1"},
    {"src": "/(.*)", "dest": "/api/index.php?__route=$1"}
  ],
  "crons": [{"path": "/cron/notifications", "schedule": "* * * * *"}]
}
